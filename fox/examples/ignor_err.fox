struct Error {
     msg string
     code int
 }

 fn divide(a int, b int) int! {
     if b == 0 {
         return Error{msg: "cannot divide by zero", code: 400}
     }
     return a / b
 }

 fn main() {
     res := divide(10, 20)!
     printf("Operation succeeded! Result is: %d\n", res)

     res = divide(10, 20)! + 30
     printf("Operation succeeded! Result is: %d\n", res)

     res = divide(10, 0)! + 30
     printf("error: %d\n", res)


 }
