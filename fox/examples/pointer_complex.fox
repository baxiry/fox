
type User struct {
    name string
    age  int
}

// Testing the return type (pointer) to match the signature
fn getPtr(u *User) *User {
    return u
}

// Testing the return type (value) to match the signature
fn getUser(u *User) User {
    // Dereferencing via field access should match User type
    return User{name: u.name, age: u.age}
}

fn main() {
    var adam = User{name: "Adam", age: 30}
    var ptr *User = &adam

    // 1. Testing the passage of a pointer and the receipt of a pointer (ReturnSig tests the pointer)
    var p2 *User = getPtr(ptr)
    printf("Pointer Name: %s\n", p2.name)

    // 2. Testing the receipt of a value from a function
    var u2 User = getUser(ptr)
    printf("Value Name: %s, Age: %d\n", u2.name, u2.age)

    // 3. Testing the qualitative comparison in assignment
    var p3 *User = p2
    printf("Success: %s\n", p3.name)
}
