func Loops(x X, y Y, z *Z) Data, int  {
    data := Data

    for i:=0; i<10; i = i+1 {
       data.x = i
    }
    i:=0
    for ; i<10; i = i+1 {
       data.x = i
    }
    for i:=0; ; i = i+1 {
       data.x = i
       if i == 10 {
           break
       }
    }
    for i:= 0; i <10; {
       data.x = i
       i =i+ 1
    }
    return data, 30 
}
